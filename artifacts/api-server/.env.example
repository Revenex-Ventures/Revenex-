DATABASE_URL=postgresql://postgres:postgres@localhost:5432/revenex
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
NODE_ENV=development
PORT=8080
APP_URL=http://localhost:5173
# Must match VITE_GOOGLE_CLIENT_ID in the frontend.
GOOGLE_CLIENT_ID=
RESEND_API_KEY=
FROM_EMAIL=team@revenex.in
OPENROUTER_API_KEY=
# Optional comma-separated approved model IDs (up to three). Default uses free routing.
OPENROUTER_MODELS=openrouter/free
# Bootstrap only creates a missing admin; it never changes existing credentials.
ADMIN_EMAIL=team@revenex.in
ADMIN_PASSWORD=
# Use 0 locally. Set this only to the trusted proxy-hop count for the host.
TRUST_PROXY_HOPS=0
